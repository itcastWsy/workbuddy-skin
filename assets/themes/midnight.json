    "light": "radial-gradient(130% 120% at 18% 0%, rgba(148,170,220,0.34) 0%, rgba(148,170,220,0) 48%), radial-gradient(120% 120% at 92% 100%, rgba(120,150,210,0.30) 0%, rgba(120,150,210,0) 52%), linear-gradient(160deg, #eef2fb 0%, #e6ecf8 100%)"
  },
  "glass": {
    "blur": 20,
    "saturate": 1.1,
