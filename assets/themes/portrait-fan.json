    "light": "radial-gradient(120% 120% at 10% 6%, rgba(190,205,150,0.55) 0%, rgba(190,205,150,0) 46%), radial-gradient(110% 110% at 94% 14%, rgba(240,205,215,0.55) 0%, rgba(240,205,215,0) 48%), linear-gradient(150deg, #f6f4ea 0%, #f1f3e6 46%, #f7eef0 100%)"
  },
