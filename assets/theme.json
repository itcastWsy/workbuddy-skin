{
  "$schema": "./theme.schema.json",
  "id": "aurora-glass",
  "name": "极光玻璃 / Aurora Glass",
  "version": 1,
  "author": "workbuddy-skin",
  "appearance": "auto",
  "comment": "背景为纯 CSS 渐变（无需图片，可直接编辑）。若要用照片壁纸，运行 start-skin.ps1 -BackgroundImage <路径>，脚本会把它写进 background.dark/light 的 url(...) 里。多个 background-image 用逗号叠加，最后一层是底色。",
  "background": {
    "dark": "radial-gradient(120% 120% at 12% 8%, rgba(99,102,241,0.55) 0%, rgba(99,102,241,0) 42%), radial-gradient(110% 110% at 92% 18%, rgba(236,72,153,0.42) 0%, rgba(236,72,153,0) 46%), radial-gradient(120% 120% at 78% 100%, rgba(20,184,166,0.42) 0%, rgba(20,184,166,0) 50%), linear-gradient(140deg, #0b1020 0%, #0d1226 45%, #141033 100%)",
    "light": "radial-gradient(120% 120% at 10% 6%, rgba(129,140,248,0.40) 0%, rgba(129,140,248,0) 44%), radial-gradient(110% 110% at 94% 14%, rgba(244,114,182,0.36) 0%, rgba(244,114,182,0) 46%), radial-gradient(120% 120% at 82% 100%, rgba(45,212,191,0.34) 0%, rgba(45,212,191,0) 50%), linear-gradient(140deg, #eef1ff 0%, #f5f0ff 46%, #eafaf6 100%)"
  },
  "glass": {
    "blur": 22,
    "saturate": 1.25,
    "panelOpacityDark": 0.46,
    "panelOpacityLight": 0.4,
    "cardOpacityDark": 0.34,
    "cardOpacityLight": 0.46,
    "chatScrimDark": 0.3,
    "chatScrimLight": 0.08,
    "tintLight": "255,250,243"
  }
}
